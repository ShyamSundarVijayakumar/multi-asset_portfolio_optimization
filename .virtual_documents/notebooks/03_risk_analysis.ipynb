def clean_data(df):
    """Safely handles missing gaps (NaNs) via forward-filling and forces numeric types."""
    df = df.ffill()
    df = df.apply(pd.to_numeric, errors='coerce')
    df = df.replace([np.inf, -np.inf], np.nan).fillna(0)
    return df

def infer_trading_days(returns_col):
    """Dynamically detects if a specific asset trades 252 days or 365 days."""
    try:
        returns_col = returns_col.dropna()
        if len(returns_col) < 20: return 252
        days_span = (returns_col.index.max() - returns_col.index.min()).days
        if days_span == 0: return 252
        
        obs_per_year = len(returns_col) / (days_span / 365.25)
        return 365 if obs_per_year > 300 else 252
    except Exception:
        return 252

def infer_trading_days(returns_col, asset_label=""):
    """Dynamically detects if a specific asset trades 252 days or 365 days."""
    try:
        returns_col = returns_col.dropna()
        n = len(returns_col)

        print(f"\n[infer_trading_days] asset={asset_label} n_obs={n}")

        if n < 20:
            print(" -> n_obs < 20, returning 252")
            return 252

        start = returns_col.index.min()
        end = returns_col.index.max()
        days_span = (end - start).days
        print(f" start={start} end={end} days_span={days_span}")

        if days_span == 0:
            print(" -> days_span == 0, returning 252")
            return 252

        obs_per_year = n / (days_span / 365.25)
        print(f" obs_per_year={obs_per_year}")

        result = 365 if obs_per_year > 300 else 252
        print(f" -> obs_per_year > 300 ? {obs_per_year > 300} => returning {result}")
        return result
    except Exception as e:
        print(f"[infer_trading_days] asset={asset_label} ERROR: {e} returning 247")
        return 252

